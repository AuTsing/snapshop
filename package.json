{
    "name": "snapshop",
    "version": "4.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vp dev",
        "build": "vue-tsc -b && vp build",
        "preview": "vp preview",
        "build:vscode": "vue-tsc -b && vp build --mode vscode-production --outDir ../../dist/snapshop --emptyOutDir",
        "watch:vscode": "vp build --watch --mode vscode-development --outDir ../../dist/snapshop --emptyOutDir"
    },
    "devDependencies": {
        "@ant-design/icons-vue": "^7.0.0",
        "@types/node": "^24.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/tsconfig": "^0.9.0",
        "@vueuse/core": "^14.0.0",
        "ant-design-vue": "^4.0.0",
        "axios": "^1.0.0",
        "cbor-x": "^1.0.0",
        "jimp": "0.16.1",
        "pinia": "^3.0.0",
        "typescript": "^5.0.0",
        "unplugin-vue-components": "^32.0.0",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vue": "^3.0.0",
        "vue-router": "^5.0.0",
        "vue-tsc": "^3.0.0"
    },
    "packageManager": "pnpm@10.33.0"
}
